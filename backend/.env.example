# Port the NestJS server listens on
PORT=4000

# Comma-separated list of allowed origins for CORS (your Next.js frontend URL)
CORS_ORIGIN=http://localhost:3000

# Where contact form submissions get forwarded (optional).
# Leave blank to just log to console + persist to data/contacts.jsonl.
NOTIFY_EMAIL=devansh@nexttoppers.com

# Slack webhook to post new leads to (optional)
SLACK_WEBHOOK_URL=
